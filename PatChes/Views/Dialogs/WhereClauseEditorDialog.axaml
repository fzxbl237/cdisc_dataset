<UserControl
    d:DesignHeight="650"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="PatChes.Views.Dialogs.WhereClauseEditorDialog"
    x:DataType="vm:WhereClauseEditorViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:antd-icons="https://atomui.net/icons/antdesign"
    xmlns:atom="https://atomui.net"
    xmlns:controls="clr-namespace:PatChes.Controls"
    xmlns:customGrid="using:PatChes.Controls.DataGrid"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:defines="clr-namespace:PatChes.ViewModels.Defines"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:PatChes.Models.Dto"
    xmlns:vm="using:PatChes.ViewModels.Dialogs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Margin="20"
        RowDefinitions="Auto,Auto,260,Auto"
        RowSpacing="12"
        Width="1000">
        <TextBlock
            FontSize="18"
            FontWeight="Bold"
            Text="{Binding Title}" />

        <Border
            Background="#0F000000"
            CornerRadius="6"
            Grid.Row="1"
            Padding="10">
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Expression Preview" />
                <TextBlock Text="{Binding ExpressionPreview}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>


        <customGrid:DataGrid
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            CanUserReorderRows="True"
            ColumnHeaderHeight="0"
            Grid.Row="2"
            GridLinesVisibility="Horizontal"
            IsReadOnly="False"
            IsSearchBarVisible="False"
            ItemsSource="{Binding WhereClauses}"
            Margin="0,4"
            RowHeight="32">
            <customGrid:DataGrid.RowDragFeedbackTemplate>
                <DataTemplate x:DataType="model:WhereClauseDto">
                    <Border
                        Background="White"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1"
                        BoxShadow="0 4 12 0 #30000000"
                        CornerRadius="4"
                        Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <atom:TextBlock
                                FontSize="16"
                                Foreground="#434343"
                                Text="↕"
                                VerticalAlignment="Center" />
                            <atom:TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding Variable}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </customGrid:DataGrid.RowDragFeedbackTemplate>
            <customGrid:DataGrid.Columns>
                <customGrid:DataGridTextColumn
                    Binding="{Binding Seq}"
                    Header="Seq"
                    IsReadOnly="True"
                    Width="40" />
                <customGrid:DataGridAutoCompleteColumn
                    Binding="{Binding Variable}"
                    Header="Variable"
                    IsReadOnly="False"
                    OptionsSource="{Binding #Root.((vm:WhereClauseEditorViewModel)DataContext).VariableOptions}"
                    Width="320">
                    <customGrid:DataGridAutoCompleteColumn.OptionTemplate>
                        <DataTemplate x:DataType="defines:ValueLevelAutoCompleteOption">
                            <StackPanel Margin="0,2" Spacing="5">
                                <atom:TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding Variable.VariableName, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                                <atom:TextBlock
                                    FontSize="12"
                                    Foreground="#1677ff"
                                    HorizontalAlignment="Left"
                                    Text="{Binding Variable.Label, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </customGrid:DataGridAutoCompleteColumn.OptionTemplate>
                </customGrid:DataGridAutoCompleteColumn>
                <customGrid:DataGridComboBoxColumn
                    Binding="{Binding Comparator}"
                    Header="Comparator"
                    IsReadOnly="False"
                    ItemsSource="{Binding #Root.((vm:WhereClauseEditorViewModel)DataContext).Comparators}"
                    Width="140" />

                <customGrid:DataGridDynamicColumn
                    Binding="{Binding Values}"
                    Header="Values"
                    IsReadOnly="False"
                    Width="320" />
                <customGrid:DataGridTemplateColumn Header="Actions" Width="140">
                    <customGrid:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="model:WhereClauseDto">
                            <StackPanel
                                Margin="20,0,0,0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <atom:Button
                                    Command="{Binding #Root.((vm:WhereClauseEditorViewModel)DataContext).AddAfterCommand}"
                                    CommandParameter="{Binding}"
                                    Content="and" />

                                <atom:Button
                                    ButtonType="Default"
                                    Command="{Binding #Root.((vm:WhereClauseEditorViewModel)DataContext).DeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Icon="{antd-icons:AntDesignIconProvider Kind=DeleteOutlined}"
                                    IsVisible="{Binding CanDelete}"
                                    Shape="Default" />
                            </StackPanel>
                        </DataTemplate>
                    </customGrid:DataGridTemplateColumn.CellTemplate>
                </customGrid:DataGridTemplateColumn>
            </customGrid:DataGrid.Columns>
        </customGrid:DataGrid>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="12">
            <atom:Button
                ButtonType="Default"
                Command="{Binding CancelCommand}"
                Content="取消" />
            <atom:Button
                ButtonType="Primary"
                Command="{Binding ConfirmCommand}"
                Content="确认" />
        </StackPanel>
    </Grid>
</UserControl>
