<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="PatChes.Views.Defines.TermView"
    x:DataType="vm:TermViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:antd-icons="https://atomui.net/icons/antdesign"
    xmlns:atom="https://atomui.net"
    xmlns:controls="using:PatChes.Controls"
    xmlns:customGrid="using:PatChes.Controls.DataGrid"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:PatChes.ViewModels.Dialogs"
    xmlns:dto="clr-namespace:PatChes.Models.Dto"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:PatChes.Models"
    xmlns:vm="clr-namespace:PatChes.ViewModels.Defines"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding DiscardCommand}" Gesture="Escape" />
    </UserControl.KeyBindings>
    <atom:Skeleton
        HorizontalAlignment="Stretch"
        IsActive="True"
        IsLoading="{Binding IsLoading}"
        ParagraphRows="10"
        VerticalAlignment="Stretch">
        <Grid RowDefinitions="50,*,50">
            <!-- Original native toolbar and DataGrid retained for migration reference.
        <DockPanel>
                <atom:LineEdit
                    DockPanel.Dock="Left"
                    IsAllowClear="True"
                    MinWidth="200"
                    PlaceholderText="Please input search string"
                    Text="{Binding SearchText}" />
                <StackPanel
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="15">
                    <atom:Button
                        ButtonType="Primary"
                        Command="{Binding AddTermCommand}"
                        Content="Add New"
                        Icon="{antd-icons:AntDesignIconProvider Kind=PlusOutlined}" />
                    <atom:Button
                        ButtonType="Default"
                        Command="{Binding PairCommand}"
                        Content="Pair"
                        Icon="{antd-icons:AntDesignIconProvider Kind=ApiOutlined}" />
                </StackPanel>

            </DockPanel>
            <DataGrid
                CanUserSortColumns="False"
                FrozenColumnCount="1"
                Grid.Row="1"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Visible"
                IsReadOnly="False"
                ItemsSource="{Binding Terms}"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="PreparingCellForEdit">
                        <InvokeCommandAction Command="{Binding PreparingCellForEditCommand}" PassEventArgsToCommand="True" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
                <DataGrid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style Selector="DataGridCell.template:cell-selected">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="DataGridRow">
                        <Setter Property="ContextMenu">
                            <atom:ContextMenu x:DataType="dto:TermDto">
                                <atom:MenuItem
                                    Command="{Binding #Root.((vm:TermViewModel)DataContext).DeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Header="Delete"
                                    Icon="{antd-icons:AntDesignIconProvider Kind=DeleteOutlined}" />
                                [comment] <atom:PopupConfirm Title="Sure to delete?"> [/comment]
                                [comment]     <Interaction.Behaviors> [/comment]
                                [comment]         <EventTriggerBehavior EventName="Confirmed"> [/comment]
                                [comment]             <InvokeCommandAction Command="{Binding #Root.((vm:TermViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" /> [/comment]
                                [comment]         </EventTriggerBehavior> [/comment]
                                [comment]     </Interaction.Behaviors> [/comment]
                                [comment]     <atom:MenuItem Header="Delete" /> [/comment]
                                [comment] </atom:PopupConfirm> [/comment]
                            </atom:ContextMenu>
                        </Setter>
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        CanUserResize="False"
                        Header=""
                        IsReadOnly="True"
                        Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <atom:CheckBox
                                    HorizontalAlignment="Center"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <controls:DataGridAtomNumericUpDownColumn
                        Binding="{Binding Order}"
                        Header="Order"
                        Increment="1"
                        IsReadOnly="False"
                        Minimum="1"
                        Width="100" />

                    <controls:DataGridAtomAutoCompleteColumn
                        Binding="{Binding CodeListUniqueId}"
                        Header="CodeList"
                        IsReadOnly="False"
                        OptionsSource="{Binding CodeListOptions}"
                        Width="200">
                        <controls:DataGridAtomAutoCompleteColumn.OptionTemplate>
                            <DataTemplate x:DataType="vm:CodeListAutoCompleteOption">
                                <StackPanel Margin="0,5">
                                    <atom:TextBlock
                                        HorizontalAlignment="Left"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                    <atom:TextBlock
                                        FontSize="12"
                                        Foreground="#1677ff"
                                        HorizontalAlignment="Left"
                                        Text="{Binding CodeList.Name}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridAtomAutoCompleteColumn.OptionTemplate>
                    </controls:DataGridAtomAutoCompleteColumn>

                    <controls:DataGridAtomAutoCompleteColumn
                        Binding="{Binding Name}"
                        Header="Term"
                        IsReadOnly="False"
                        OptionsAsyncLoader="{Binding TermOptionsAsyncLoader}"
                        Width="250">
                        <controls:DataGridAtomAutoCompleteColumn.OptionTemplate>
                            <DataTemplate x:DataType="dialogs:TermCompleteOption">
                                <StackPanel Margin="0,5">
                                    <atom:TextBlock
                                        HorizontalAlignment="Left"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                    <atom:TextBlock
                                        FontSize="12"
                                        Foreground="#1677ff"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding !SynonymsIsEmpty}"
                                        Text="{Binding Header}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridAtomAutoCompleteColumn.OptionTemplate>
                    </controls:DataGridAtomAutoCompleteColumn>

                    <controls:DataGridAtomLineEditColumn
                        Binding="{Binding Code}"
                        Header="NCI Code"
                        IsReadOnly="True"
                        Width="200" />
                    [comment]  <DataGridCheckBoxColumn  [/comment]
                    [comment]  Binding="{Binding IsNameDuplicate}"  [/comment]
                    [comment]  Header="Duplicate"  [/comment]
                    [comment]  IsReadOnly="False" />  [/comment]
                    [comment] <DataGridTextColumn Binding="{Binding DecodedValue}" Header="Decoded Value" /> [/comment]
                    <controls:DataGridAtomLineEditColumn
                        Binding="{Binding DecodedValue}"
                        Header="Decoded Value"
                        IsReadOnly="False"
                        Width="450" />
                    [comment] <DataGridTemplateColumn Header="Pop up"> [/comment]
                    [comment]     ~1~ <DataGridTemplateColumn.CellTemplate> @1@ [/comment]
                    [comment]     ~1~     <DataTemplate> @1@ [/comment]
                    [comment]     ~1~         <atom:TextBlock Text="aaa" /> @1@ [/comment]
                    [comment]     ~1~     </DataTemplate> @1@ [/comment]
                    [comment]     ~1~ </DataGridTemplateColumn.CellTemplate> @1@ [/comment]
                    [comment]     <DataGridTemplateColumn.CellTemplate> [/comment]
                    [comment]         <DataTemplate> [/comment]
                    [comment]             <atom:FlyoutHost IsShowArrow="True" Trigger="Click"> [/comment]
                    [comment]                 <atom:FlyoutHost.Flyout> [/comment]
                    [comment]                     <atom:Flyout> [/comment]
                    [comment]                         <atom:LineEdit PlaceholderText="aaa" /> [/comment]
                    [comment]                     </atom:Flyout> [/comment]
                    [comment]                 </atom:FlyoutHost.Flyout> [/comment]
                    [comment]                 <atom:HyperLinkTextBlock Text="aaa" VerticalAlignment="Center" /> [/comment]
                    [comment]             </atom:FlyoutHost> [/comment]
                    [comment]    [/comment]
                    [comment]         </DataTemplate> [/comment]
                    [comment]     </DataGridTemplateColumn.CellTemplate> [/comment]
                    [comment] </DataGridTemplateColumn> [/comment]
                </DataGrid.Columns>
            </DataGrid>
            -->
            <customGrid:DataGrid
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                ColumnHeaderHeight="34"
                Grid.Row="0"
                Grid.RowSpan="2"
                ItemsSource="{Binding Terms}"
                LeftFrozenColumnCount="2"
                Margin="8,4"
                RowHeight="32"
                x:Name="TermsGrid">
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="PreparingCellForEdit">
                        <InvokeCommandAction Command="{Binding PreparingCellForEditCommand}" PassEventArgsToCommand="True" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
                <customGrid:DataGrid.Styles>
                    <Style Selector="customGrid|DataGridRow">
                        <Setter Property="ContextMenu">
                            <atom:ContextMenu x:DataType="dto:TermDto">
                                <atom:MenuItem
                                    Command="{Binding #Root.((vm:TermViewModel)DataContext).EditTermsCommand}"
                                    CommandParameter="{Binding}"
                                    Header="Edit Terms"
                                    Icon="{antd-icons:AntDesignIconProvider Kind=EditOutlined}" />
                                <atom:MenuItem
                                    Command="{Binding #Root.((vm:TermViewModel)DataContext).DeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Header="Delete"
                                    Icon="{antd-icons:AntDesignIconProvider Kind=DeleteOutlined}" />
                                <atom:MenuItem
                                    Command="{Binding #Root.((vm:TermViewModel)DataContext).DeleteSelectedCommand}"
                                    Header="Delete Selected"
                                    Icon="{antd-icons:AntDesignIconProvider Kind=DeleteOutlined}" />
                            </atom:ContextMenu>
                        </Setter>
                    </Style>
                </customGrid:DataGrid.Styles>
                <customGrid:DataGrid.SearchBarRightContent>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:ToggleSwitch
                            IsChecked="{Binding IsErrorOnly}"
                            OffContent="All"
                            OnContent="Has Error"
                            VerticalAlignment="Center" />
                        <atom:Button
                            Color="Default"
                            Command="{Binding AddTermCommand}"
                            Content="Add New"
                            Icon="{antd-icons:AntDesignIconProvider Kind=PlusOutlined}"
                            Variant="Solid" />
                        <atom:Button
                            Color="Default"
                            Command="{Binding PairCommand}"
                            Content="Pair"
                            Icon="{antd-icons:AntDesignIconProvider Kind=ApiOutlined}"
                            Variant="Solid" />
                    </StackPanel>
                </customGrid:DataGrid.SearchBarRightContent>
                <customGrid:DataGrid.Columns>
                    <customGrid:DataGridCheckBoxColumn
                        Binding="{Binding IsSelected}"
                        Header=""
                        IsReadOnly="False"
                        Width="40" />
                    <customGrid:DataGridNumericUpDownColumn
                        Binding="{Binding Order}"
                        Header="Order"
                        Increment="1"
                        IsReadOnly="False"
                        Minimum="1"
                        Width="100" />
                    <customGrid:DataGridAutoCompleteColumn
                        Binding="{Binding CodeListUniqueId}"
                        Header="CodeList"
                        IsReadOnly="False"
                        OptionsSource="{Binding CodeListOptions}"
                        Width="200">
                        <customGrid:DataGridAutoCompleteColumn.OptionTemplate>
                            <DataTemplate x:DataType="vm:CodeListAutoCompleteOption">
                                <StackPanel Margin="0,5">
                                    <atom:TextBlock
                                        HorizontalAlignment="Left"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                    <atom:TextBlock
                                        FontSize="12"
                                        Foreground="#1677ff"
                                        HorizontalAlignment="Left"
                                        Text="{Binding CodeList.Name}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </customGrid:DataGridAutoCompleteColumn.OptionTemplate>
                    </customGrid:DataGridAutoCompleteColumn>
                    <customGrid:DataGridAutoCompleteColumn
                        Binding="{Binding Name}"
                        Header="Term"
                        IsReadOnly="False"
                        OptionsAsyncLoader="{Binding TermOptionsAsyncLoader}"
                        Width="250">
                        <customGrid:DataGridAutoCompleteColumn.OptionTemplate>
                            <DataTemplate x:DataType="dialogs:TermCompleteOption">
                                <StackPanel Margin="0,5">
                                    <atom:TextBlock
                                        HorizontalAlignment="Left"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                    <atom:TextBlock
                                        FontSize="12"
                                        Foreground="#1677ff"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding !SynonymsIsEmpty}"
                                        Text="{Binding Header}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </customGrid:DataGridAutoCompleteColumn.OptionTemplate>
                    </customGrid:DataGridAutoCompleteColumn>
                    <customGrid:DataGridTextColumn
                        Binding="{Binding Code}"
                        Header="NCI Code"
                        IsReadOnly="True"
                        Width="200" />
                    <customGrid:DataGridTextColumn
                        Binding="{Binding DecodedValue}"
                        Header="Decoded Value"
                        IsReadOnly="False"
                        Width="450" />
                </customGrid:DataGrid.Columns>
            </customGrid:DataGrid>
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Margin="0,0,15,0"
                Orientation="Horizontal"
                Spacing="15"
                VerticalAlignment="Center">
                <atom:Button
                    ButtonType="Primary"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    IsEnabled="{Binding HasChanges}"
                    SizeType="Middle"
                    atom:ToolTip.Tip="Save(Ctrl+S)" />

                <atom:Button
                    ButtonType="Primary"
                    Command="{Binding DiscardCommand}"
                    Content="Discard"
                    IsDanger="True"
                    IsEnabled="{Binding HasChanges}"
                    SizeType="Middle"
                    atom:ToolTip.Tip="Discard(Esc)" />
            </StackPanel>
        </Grid>
    </atom:Skeleton>
</UserControl>
