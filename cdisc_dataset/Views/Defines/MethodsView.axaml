<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="cdisc_dataset.Views.Defines.MethodsView"
    x:DataType="vm:MethodsViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:antd-icons="https://atomui.net/icons/antdesign"
    xmlns:atom="https://atomui.net"
    xmlns:controls="using:cdisc_dataset.Controls"
    xmlns:converter="using:cdisc_dataset.Converters"
    xmlns:customGrid="using:cdisc_dataset.Controls.DataGrid"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="clr-namespace:cdisc_dataset.Models.Dto"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:cdisc_dataset.ViewModels.Defines"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding DiscardCommand}" Gesture="Escape" />
    </UserControl.KeyBindings>
    <atom:Skeleton
        HorizontalAlignment="Stretch"
        IsActive="True"
        IsLoading="{Binding IsLoading}"
        ParagraphRows="10"
        VerticalAlignment="Stretch">
        <Grid RowDefinitions="50,*,50">
            <!-- Original native toolbar and DataGrid retained for migration reference.
        <DockPanel Margin="10,8">
            <atom:LineEdit
                DockPanel.Dock="Left"
                IsAllowClear="True"
                MinWidth="200"
                Text="{Binding SearchText}"
                Watermark="请输入搜索字段" />
            <StackPanel
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <atom:Button
                    ButtonType="Primary"
                    Command="{Binding AddMethodCommand}"
                    Content="新增"
                    Icon="{antd-icons:AntDesignIconProvider Kind=PlusOutlined}" />
            </StackPanel>
        </DockPanel>
        <DataGrid
            CanUserSortColumns="False"
            Grid.Row="1"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            HorizontalScrollBarVisibility="Visible"
            IsReadOnly="False"
            ItemsSource="{Binding Methods}"
            SelectionUnit="FullRow">
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="ContextMenu">
                        <atom:ContextMenu x:DataType="dto:MethodDto">
                            <atom:MenuItem
                                Command="{Binding #Root.((vm:MethodsViewModel)DataContext).EditMethodCommand}"
                                CommandParameter="{Binding}"
                                Header="Edit" />
                            <atom:MenuItem
                                Command="{Binding #Root.((vm:MethodsViewModel)DataContext).DeleteCommand}"
                                CommandParameter="{Binding}"
                                Header="Delete"
                                Icon="{antd-icons:AntDesignIconProvider Kind=DeleteOutlined}" />
                        </atom:ContextMenu>
                    </Setter>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <controls:DataGridAtomLineEditColumn
                    Binding="{Binding UniqueId}"
                    Header="Id"
                    IsReadOnly="False"
                    Width="200" />

                <controls:DataGridAtomLineEditColumn
                    Binding="{Binding Name}"
                    Header="Name"
                    IsReadOnly="False"
                    Width="200" />

                <controls:DataGridAtomComboBoxColumn
                    Binding="{Binding Type}"
                    Header="Type"
                    IsReadOnly="False"
                    ItemsSource="{Binding Types}"
                    Width="150" />

                <controls:DataGridAtomLineEditColumn
                    Binding="{Binding Description}"
                    Header="Description"
                    IsReadOnly="False"
                    Width="250" />


                <controls:DataGridAtomLineEditColumn
                    Binding="{Binding ExpressionContext}"
                    Header="Expression Context"
                    IsReadOnly="False"
                    Width="250" />

                <controls:DataGridAtomLineEditColumn
                    Binding="{Binding ExpressionCode}"
                    Header="Expression Code"
                    IsReadOnly="False"
                    Width="250" />

                <controls:DataGridAtomAutoCompleteColumn
                    Binding="{Binding DocumentUniqueId}"
                    Header="Document"
                    IsReadOnly="False"
                    OptionsSource="{Binding DocumentOptions}"
                    Width="200">
                    <controls:DataGridAtomAutoCompleteColumn.OptionTemplate>
                        <DataTemplate x:DataType="vm:DocumentAutoCompleteOption">
                            <StackPanel Margin="0,5">
                                <atom:TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding Content}"
                                    TextWrapping="Wrap" />
                                <atom:TextBlock
                                    FontSize="12"
                                    Foreground="#1677ff"
                                    HorizontalAlignment="Left"
                                    Text="{Binding Document.Title}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridAtomAutoCompleteColumn.OptionTemplate>
                </controls:DataGridAtomAutoCompleteColumn>

                <controls:DataGridAtomLineEditColumn
                    Binding="{Binding Pages}"
                    Header="Pages"
                    IsReadOnly="False"
                    Width="200" />

                [comment] <DataGridTemplateColumn Header="Type" Width="120"> [/comment]
                [comment]     <DataGridTemplateColumn.CellTemplate> [/comment]
                [comment]         <DataTemplate> [/comment]
                [comment]             <atom:LineEdit Text="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /> [/comment]
                [comment]         </DataTemplate> [/comment]
                [comment]     </DataGridTemplateColumn.CellTemplate> [/comment]
                [comment] </DataGridTemplateColumn> [/comment]

                [comment] <DataGridTemplateColumn Header="ExpressionContext" Width="180"> [/comment]
                [comment]     <DataGridTemplateColumn.CellTemplate> [/comment]
                [comment]         <DataTemplate> [/comment]
                [comment]             <atom:LineEdit Text="{Binding ExpressionContext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /> [/comment]
                [comment]         </DataTemplate> [/comment]
                [comment]     </DataGridTemplateColumn.CellTemplate> [/comment]
                [comment] </DataGridTemplateColumn> [/comment]
                [comment] <DataGridTemplateColumn Header="ExpressionCode" Width="200"> [/comment]
                [comment]     <DataGridTemplateColumn.CellTemplate> [/comment]
                [comment]         <DataTemplate> [/comment]
                [comment]             <atom:LineEdit Text="{Binding ExpressionCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /> [/comment]
                [comment]         </DataTemplate> [/comment]
                [comment]     </DataGridTemplateColumn.CellTemplate> [/comment]
                [comment] </DataGridTemplateColumn> [/comment]
                [comment] <DataGridTemplateColumn Header="Pages" Width="140"> [/comment]
                [comment]     <DataGridTemplateColumn.CellTemplate> [/comment]
                [comment]         <DataTemplate> [/comment]
                [comment]             <atom:LineEdit Text="{Binding Pages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /> [/comment]
                [comment]         </DataTemplate> [/comment]
                [comment]     </DataGridTemplateColumn.CellTemplate> [/comment]
                [comment] </DataGridTemplateColumn> [/comment]
                [comment] <DataGridTemplateColumn Header="Document" Width="260"> [/comment]
                [comment]     <DataGridTemplateColumn.CellTemplate> [/comment]
                [comment]         <DataTemplate> [/comment]
                [comment]  <ComboBox  [/comment]
                [comment]  DisplayMemberBinding="{Binding UniqueId}"  [/comment]
                [comment]  IsTextSearchEnabled="True"  [/comment]
                [comment]  ItemsSource="{Binding DataContext.Documents, RelativeSource={RelativeSource AncestorType=UserControl}}"  [/comment]
                [comment]  SelectedValue="{Binding DocumentUniqueId, Mode=TwoWay}"  [/comment]
                [comment]  SelectedValuePath="UniqueId"  [/comment]
                [comment]  VerticalAlignment="Center" />  [/comment]
                [comment]         </DataTemplate> [/comment]
                [comment]     </DataGridTemplateColumn.CellTemplate> [/comment]
                [comment] </DataGridTemplateColumn> [/comment]
            </DataGrid.Columns>
        </DataGrid>
            -->
            <customGrid:DataGrid
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                ColumnHeaderHeight="34"
                Grid.Row="0"
                Grid.RowSpan="2"
                ItemsSource="{Binding Methods}"
                LeftFrozenColumnCount="1"
                Margin="8,4"
                RowHeight="32">
                <customGrid:DataGrid.Styles>
                    <Style Selector="customGrid|DataGridRow">
                        <Setter Property="ContextMenu">
                            <atom:ContextMenu x:DataType="dto:MethodDto">
                                <atom:MenuItem
                                    Command="{Binding #Root.((vm:MethodsViewModel)DataContext).EditMethodCommand}"
                                    CommandParameter="{Binding}"
                                    Header="Edit"
                                    Icon="{antd-icons:AntDesignIconProvider Kind=EditOutlined}" />
                                <atom:MenuItem
                                    Command="{Binding #Root.((vm:MethodsViewModel)DataContext).DeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Header="Delete"
                                    Icon="{antd-icons:AntDesignIconProvider Kind=DeleteOutlined}" />
                            </atom:ContextMenu>
                        </Setter>
                    </Style>
                </customGrid:DataGrid.Styles>
                <customGrid:DataGrid.SearchBarRightContent>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:ToggleSwitch
                            IsChecked="{Binding IsErrorOnly}"
                            OffContent="All"
                            OnContent="Has Error"
                            VerticalAlignment="Center" />
                        <atom:Button
                            Color="Default"
                            Command="{Binding AddMethodCommand}"
                            Content="新增"
                            Icon="{antd-icons:AntDesignIconProvider Kind=PlusOutlined}"
                            Variant="Solid" />
                    </StackPanel>
                </customGrid:DataGrid.SearchBarRightContent>
                <customGrid:DataGrid.Columns>
                    <customGrid:DataGridTextColumn
                        Binding="{Binding UniqueId}"
                        Header="Id"
                        IsReadOnly="False"
                        Width="200" />
                    <customGrid:DataGridTextColumn
                        Binding="{Binding Name}"
                        Header="Name"
                        IsReadOnly="False"
                        Width="200" />
                    <customGrid:DataGridComboBoxColumn
                        Binding="{Binding Type}"
                        Header="Type"
                        IsReadOnly="False"
                        ItemsSource="{Binding Types}"
                        Width="150" />
                    <customGrid:DataGridTextColumn
                        Binding="{Binding Description}"
                        Header="Description"
                        IsReadOnly="False"
                        Width="250" />
                    <customGrid:DataGridTextColumn
                        Binding="{Binding ExpressionContext}"
                        Header="Expression Context"
                        IsReadOnly="False"
                        Width="250" />
                    <customGrid:DataGridTextColumn
                        Binding="{Binding ExpressionCode}"
                        Header="Expression Code"
                        IsReadOnly="False"
                        Width="250" />
                    <customGrid:DataGridAutoCompleteColumn
                        Binding="{Binding DocumentUniqueId}"
                        Header="Document"
                        IsReadOnly="False"
                        OptionsSource="{Binding DocumentOptions}"
                        Width="200">
                        <customGrid:DataGridAutoCompleteColumn.OptionTemplate>
                            <DataTemplate x:DataType="vm:DocumentAutoCompleteOption">
                                <StackPanel Margin="0,5">
                                    <atom:TextBlock
                                        HorizontalAlignment="Left"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                    <atom:TextBlock
                                        FontSize="12"
                                        Foreground="#1677ff"
                                        HorizontalAlignment="Left"
                                        Text="{Binding Document.Title}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </customGrid:DataGridAutoCompleteColumn.OptionTemplate>
                        <customGrid:FloatingBar.FloatingBarTemplate>
                            <DataTemplate x:DataType="dto:MethodDto">
                                <Border
                                    Background="White"
                                    BorderBrush="{atom:SharedTokenResource ColorPrimary}"
                                    BorderThickness="0.5"
                                    BoxShadow="0 1 6 0 #18000000"
                                    CornerRadius="4"
                                    Padding="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:Button
                                            ButtonType="Link"
                                            Command="{Binding #Root.((vm:MethodsViewModel)DataContext).AddDocumentCommand}"
                                            CommandParameter="{Binding}"
                                            Content="Add New"
                                            IsVisible="{Binding Document, Converter={x:Static converter:Converters.IsNull}}"
                                            SizeType="Small" />
                                        <atom:Button
                                            ButtonType="Link"
                                            Command="{Binding #Root.((vm:MethodsViewModel)DataContext).EditDocumentCommand}"
                                            CommandParameter="{Binding}"
                                            Content="Open in Editor"
                                            IsVisible="{Binding Document, Converter={x:Static converter:Converters.IsNotNull}}"
                                            SizeType="Small" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </customGrid:FloatingBar.FloatingBarTemplate>
                    </customGrid:DataGridAutoCompleteColumn>
                    <customGrid:DataGridTextColumn
                        Binding="{Binding Pages}"
                        Header="Pages"
                        IsReadOnly="False"
                        Width="200" />
                </customGrid:DataGrid.Columns>
            </customGrid:DataGrid>
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Margin="0,0,15,0"
                Orientation="Horizontal"
                Spacing="15"
                VerticalAlignment="Center">
                <atom:Button
                    ButtonType="Primary"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    IsEnabled="{Binding HasChanges}"
                    SizeType="Middle"
                    atom:ToolTip.Tip="Save(Ctrl+S)" />

                <atom:Button
                    ButtonType="Primary"
                    Command="{Binding DiscardCommand}"
                    Content="Discard"
                    IsDanger="True"
                    IsEnabled="{Binding HasChanges}"
                    SizeType="Middle"
                    atom:ToolTip.Tip="Discard(Esc)" />
            </StackPanel>
        </Grid>
    </atom:Skeleton>
</UserControl>