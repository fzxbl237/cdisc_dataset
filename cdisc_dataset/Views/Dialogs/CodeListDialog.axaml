<UserControl
    Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="cdisc_dataset.Views.Dialogs.CodeListDialog"
    x:DataType="vm:CodeListDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:antd-icons="https://atomui.net/icons/antdesign"
    xmlns:atom="https://atomui.net"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:cdisc_dataset.Models"
    xmlns:vm="using:cdisc_dataset.ViewModels.Dialogs"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="atom|TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#172033" />
        </Style>
        <Style Selector="atom|LineEdit">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="atom|ComboBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="atom|TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="atom|TextBlock.field-label">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="atom|TextBlock.field-bold-label">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.section-line">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#D9DEE8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid
        Margin="50"
        MinWidth="800"
        RowDefinitions="Auto,*,Auto"
        Width="800">
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <atom:TextBlock
                FontSize="28"
                FontWeight="Bold"
                Foreground="#14213D"
                HorizontalAlignment="Left"
                Text="{Binding DialogTitle}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <Grid
                    ColumnDefinitions="4,Auto,*"
                    ColumnSpacing="12"
                    Height="28">
                    <Border
                        Background="#2F6BFF"
                        Classes="section-line"
                        CornerRadius="2"
                        Height="22"
                        Width="4" />
                    <atom:TextBlock
                        Classes="section-title"
                        Grid.Column="1"
                        Text="{Binding Display}" />
                </Grid>
                <Grid
                    ColumnDefinitions="100,*,100,*"
                    ColumnSpacing="14"
                    RowDefinitions="44">
                    <atom:TextBlock
                        Classes="field-label"
                        Grid.Column="0"
                        Text="Variable:" />
                    <atom:Select
                        Filter="{atom:ValueFilterProvider Contains}"
                        FilterValueSelector="{x:Static atom:Select.ValueFilterPropertySelector}"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        IsAllowClear="True"
                        IsEnabled="{Binding IsVariableSelectionVisible}"
                        IsFilterEnabled="True"
                        Mode="Single"
                        OptionsSource="{Binding Variables}"
                        SelectedOption="{Binding SelectedVariable, Mode=TwoWay}">
                        <atom:Select.OptionTemplate>
                            <DataTemplate x:DataType="vm:VariableOption">
                                <StackPanel Spacing="4">
                                    <atom:TextBlock Text="{Binding Header}" />
                                    <atom:TextBlock
                                        FontSize="13"
                                        Foreground="#5C9FF9"
                                        Text="{Binding Variable.Label}" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:Select.OptionTemplate>
                    </atom:Select>
                    <atom:TextBlock
                        Classes="field-label"
                        Grid.Column="2"
                        Text="CodeList:" />
                    <atom:Select
                        Filter="{atom:ValueFilterProvider Contains}"
                        FilterValueSelector="{x:Static atom:Select.ValueFilterPropertySelector}"
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        IsAllowClear="True"
                        IsEnabled="{Binding !IsInEditMode}"
                        IsFilterEnabled="True"
                        Mode="Single"
                        OptionsSource="{Binding CodeLists, Mode=TwoWay}"
                        SelectedOption="{Binding SelectedCodeList, Mode=TwoWay}">
                        <atom:Select.Styles>
                            <Style Selector="atom|TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </atom:Select.Styles>
                        <atom:Select.OptionTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="6" x:DataType="vm:CodeListOption">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        VerticalAlignment="Center">
                                        <atom:TextBlock Text="{Binding CodeListReference?.CodeListRef}" />
                                        <atom:Tag TagColor="success" Text="{Binding CodeListReference?.CodeListCode}" />
                                    </StackPanel>
                                    <atom:TextBlock
                                        FontSize="13"
                                        Foreground="#5C9FF9"
                                        Text="{Binding CodeListReference?.CodeListName}" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:Select.OptionTemplate>
                    </atom:Select>

                </Grid>
                <Grid
                    ColumnDefinitions="4,Auto,*"
                    ColumnSpacing="12"
                    Height="28">
                    <Border
                        Background="#2F6BFF"
                        Classes="section-line"
                        CornerRadius="2"
                        Height="22"
                        Width="4" />
                    <atom:TextBlock
                        Classes="section-title"
                        Grid.Column="1"
                        Text="Properties" />
                </Grid>
                <Grid
                    ColumnDefinitions="100,*,100,*"
                    ColumnSpacing="14"
                    RowDefinitions="44,44,44"
                    RowSpacing="12">
                    <atom:TextBlock
                        Classes="field-label"
                        Grid.Column="0"
                        Grid.Row="0"
                        Text="ID" />
                    <atom:LineEdit
                        Grid.Column="1"
                        Grid.Row="0"
                        PlaceholderText="请输入ID"
                        Text="{Binding CodeListDto.UniqueId, Mode=TwoWay}" />
                    <atom:TextBlock
                        Classes="field-label"
                        Grid.Column="2"
                        Grid.Row="0"
                        Text="Name" />
                    <atom:LineEdit
                        Grid.Column="3"
                        Grid.Row="0"
                        PlaceholderText="请输入Name"
                        Text="{Binding CodeListDto.Name, Mode=TwoWay}" />
                    <atom:TextBlock
                        Classes="field-label"
                        Grid.Column="0"
                        Grid.Row="1"
                        Text="NCI Code" />
                    <atom:LineEdit
                        Grid.Column="1"
                        Grid.Row="1"
                        IsEnabled="False"
                        PlaceholderText="请输入NCI Code"
                        Text="{Binding CodeListDto.Code, Mode=TwoWay}" />
                    <atom:TextBlock
                        Classes="field-label"
                        Grid.Column="2"
                        Grid.Row="1"
                        Text="Terminology:" />
                    <atom:ComboBox
                        Grid.Column="3"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Terminologies}"
                        SelectedItem="{Binding CodeListDto.Terminology, Mode=TwoWay}" />
                    <atom:TextBlock
                        Classes="field-label"
                        Grid.Column="0"
                        Grid.Row="2"
                        Text="Type" />
                    <atom:ComboBox
                        Grid.Column="1"
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Types}"
                        SelectedIndex="0"
                        SelectedItem="{Binding CodeListDto.Type, Mode=TwoWay}"
                        Width="170" />
                    <atom:TextBlock
                        Classes="field-label"
                        Grid.Column="2"
                        Grid.Row="2"
                        Text="Comment" />
                    <atom:Select
                        Filter="{atom:ValueFilterProvider Contains}"
                        FilterValueSelector="{x:Static atom:Select.ValueFilterPropertySelector}"
                        Grid.Column="3"
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        IsAllowClear="True"
                        IsFilterEnabled="True"
                        MaxWidth="500"
                        Mode="Single"
                        OptionsSource="{Binding Comments, Mode=TwoWay}"
                        SelectedOption="{Binding SelectedComment, Mode=TwoWay}"
                        VerticalAlignment="Center">
                        <atom:Select.Styles>
                            <Style Selector="atom|TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </atom:Select.Styles>
                        <atom:Select.OptionTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="10" x:DataType="atom:SelectOption">
                                    <atom:TextBlock Text="{Binding Header}" />
                                    <atom:TextBlock
                                        FontSize="13"
                                        Foreground="#5C9FF9"
                                        Text="{Binding ((model:Comment)Content).Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:Select.OptionTemplate>
                    </atom:Select>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border
            BorderBrush="#E6EAF0"
            Grid.Row="2"
            Padding="0,18,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="14">
                <atom:Button
                    ButtonType="Default"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
                <atom:Button
                    ButtonType="Primary"
                    Command="{Binding SaveCommand}"
                    Content="确认" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
