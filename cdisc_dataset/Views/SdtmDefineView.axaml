<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="cdisc_dataset.Views.SdtmDefineView"
    x:DataType="vm:SdtmDefineViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:an="https://github.com/NeverMorewd/AsyncNavigation"
    xmlns:antd-icons="https://atomui.net/icons/antdesign"
    xmlns:atom="https://atomui.net"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:cdisc_dataset.Models"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="using:cdisc_dataset.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Loaded">
            <InvokeCommandAction Command="{Binding LoadCommand}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>
    <Grid RowDefinitions="36,*">
        <Grid ColumnDefinitions="*,Auto">
            <atom:ThemeConfigProvider Config="{Binding SegmentedConfig}">
                <atom:Segmented ItemsSource="{Binding SegmentedItems}" SelectedItem="{Binding SelectedSegmentedItem}" />
            </atom:ThemeConfigProvider>
            <atom:SplitButton
                Grid.Column="1"
                Command="{Binding PreviewDefineXmlCommand}"
                Content="预览"
                Icon="{antd-icons:AntDesignIconProvider Kind=EyeOutlined}"
                Margin="0,0,12,0">
                <atom:SplitButton.Flyout>
                    <atom:Flyout Placement="Bottom">
                        <StackPanel>
                            <atom:MenuItem
                                Command="{Binding ExportDefineXmlCommand}"
                                Header="导出 XML"
                                Icon="{antd-icons:AntDesignIconProvider Kind=ExportOutlined}" />
                            <atom:MenuItem
                                Command="{Binding ExportDefineExcelCommand}"
                                Header="导出 Excel"
                                Icon="{antd-icons:AntDesignIconProvider Kind=ExportOutlined}" />
                        </StackPanel>
                    </atom:Flyout>
                </atom:SplitButton.Flyout>
            </atom:SplitButton>
        </Grid>
        <!-- <atom:Segmented ItemsSource="{Binding SegmentedItems}" SelectedItem="{Binding SelectedSegmentedItem}" /> -->
        <ContentControl
            Grid.Row="1"
            Margin="12,12,12,12"
            an:RegionManager.RegionName="SdtmDefineRegion" />
    </Grid>

</UserControl>
